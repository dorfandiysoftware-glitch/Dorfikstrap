<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Dorfikstrap" parent="Theme.Material3.DayNight.NoActionBar" />

    <style name="Theme.Dorfikstrap.Translucent" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- Static green accent, used when Material 3 dynamic colours are turned off. -->
    <style name="Overlay.Green" parent="ThemeOverlay.Material3">
        <item name="colorPrimary">#66DD77</item>
        <item name="colorOnPrimary">#00390F</item>
        <item name="colorPrimaryContainer">#0F5A24</item>
        <item name="colorOnPrimaryContainer">#A8F5B0</item>
        <item name="colorSecondary">#8FD99A</item>
        <item name="colorSecondaryContainer">#1B3A22</item>
        <item name="colorOnSecondaryContainer">#C5EBC9</item>
    </style>

    <!-- Pure black surfaces for AMOLED screens. -->
    <style name="Overlay.Amoled" parent="ThemeOverlay.Material3">
        <item name="android:colorBackground">#000000</item>
        <item name="colorSurface">#000000</item>
        <item name="colorSurfaceContainerLowest">#000000</item>
        <item name="colorSurfaceContainerLow">#070707</item>
        <item name="colorSurfaceContainer">#0E0E0E</item>
        <item name="colorSurfaceContainerHigh">#151515</item>
        <item name="colorSurfaceContainerHighest">#1C1C1C</item>
    </style>
</resources>
